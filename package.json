  "devDependencies": {
    "concurrently": "^9.1.0", "eslint": "^9.20.0", "@eslint/js": "^9.20.0",
    "typescript-eslint": "^8.71.2", "globals": "^15.14.0",
    "eslint-plugin-react-hooks": "^7.1.1", "typescript": "~5.7.3"
  }
}
